{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/deepseek-v4.1-flash",
  "default_agent": "build",
  "agents": {
    "build": {
      "model": "opencode-go/deepseek-v4.1-flash#max"
    }
  },
  "formatter": true,
  "watcher": {
    "ignore": [
      "node_modules/**",
      "dist/**"
    ]
  },
  "instructions": [
    "AGENTS.md"
  ],
  "lsp": {
    "tailwindcss": {
      "command": [
        "npx",
        "-y",
        "--package",
        "@tailwindcss/language-server",
        "--",
        "tailwindcss-language-server",
        "--stdio"
      ],
      "extensions": [
        ".css"
      ]
    },
    "json": {
      "command": [
        "npx",
        "-y",
        "--package",
        "vscode-langservers-extracted",
        "--",
        "vscode-json-language-server",
        "--stdio"
      ],
      "extensions": [
        ".json",
        ".jsonc"
      ]
    }
  },
  "mcp": {
    "servers": {
      "tailwindcss": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "tailwindcss-mcp-server"
        ],
        "disabled": false
      }
    }
  }
}